# BigWigs packager config. Publishes to GitHub Releases ONLY (no CurseForge/
# Wago) — same model as the rest of the suite. WoWUp installs + auto-updates
# from those releases via the repo URL.

package-as: GloomsOverlays

enable-nolib-creation: no

# No embedded libraries, deliberately. Overlays loads none — no Libs\ lines in
# the TOC. It hard-depends on GloomsHub (`## Dependencies: GloomsHub`) and gets
# LibSharedMedia, the design toolkit (LibGloomSkin-1.0) and the media resolver
# from the Hub at runtime. Do NOT add LibGloomSkin as an external here: there
# is no standalone repo for it, and a second copy would be exactly the drift
# the suite exists to prevent.

# Keep repo-management files out of the packaged addon zip.
ignore:
  - README.md
  - CLAUDE.md
  - .claude
  - .github
  - .gitignore
  - .pkgmeta
  - docs
